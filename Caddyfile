{
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# OpenClaw Social Media Automation — Reverse Proxy
#
# Replace {$DOMAIN} with your actual domain, or set DOMAIN in .env.production
# Caddy auto-provisions TLS certificates via Let's Encrypt.
#
# ROUTING:
#   /           → Dashboard (EYES)
#   /n8n/       → n8n workflows (NERVOUS SYSTEM)
#   /api/       → OpenClaw gateway (BRAIN)
#   /media-api/ → Media worker (HANDS)

{$DOMAIN::80} {
	# ── Access gate until the shared Google login is wired ─────────────
	# The front door (/), the live demo (/try), their assets and icon are
	# public; the workspace and everything behind it asks for the Studio login.
	@private not path / /try /assets/* /favicon.svg
	basic_auth @private bcrypt "4XOR Studio" {
		{$STUDIO_USER:admin} {$STUDIO_PASS_HASH}
	}

	# ── Dashboard (default) ──────────────────────────────────────────────
	handle {
		# Public pages are read-only (inside the handle: respond runs before reverse_proxy)
		@publicWrite {
			path / /try /assets/* /favicon.svg
			not method GET HEAD
		}
		respond @publicWrite 405
		reverse_proxy dashboard:3000
	}

	# ── n8n Workflow Editor ──────────────────────────────────────────────
	handle /n8n/* {
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	# ── n8n Webhooks (called by dashboard + external triggers) ───────────
	handle /webhook/* {
		reverse_proxy n8n:5678
	}
	handle /webhook-test/* {
		reverse_proxy n8n:5678
	}

	# ── OpenClaw API (internal, but exposed for admin/debug) ─────────────
	handle /api/* {
		reverse_proxy openclaw-gateway:18789
	}

	# ── Media Worker API ─────────────────────────────────────────────────
	handle /media-api/* {
		uri strip_prefix /media-api
		reverse_proxy media-worker:3001
	}

	# ── Static media files (thumbnails, previews) ────────────────────────
	handle /media/* {
		root * /data
		file_server browse
	}

	# ── Security headers ─────────────────────────────────────────────────
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	# ── Request size limit (500MB for video uploads) ─────────────────────
	request_body {
		max_size 500MB
	}

	# ── Logging ──────────────────────────────────────────────────────────
	log {
		output stdout
		format json
	}
}
