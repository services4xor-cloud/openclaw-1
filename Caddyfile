{
	servers {
		timeouts {
			read_header 10s
			idle 2m
		}
	}
}

# OpenClaw Social Media Automation — Reverse Proxy
#
# Replace {$DOMAIN} with your actual domain, or set DOMAIN in .env.production
# Caddy auto-provisions TLS certificates via Let's Encrypt.
#
# ROUTING:
#   /           → Dashboard (EYES)
#   /n8n/       → n8n workflows (NERVOUS SYSTEM)
#   /api/       → OpenClaw gateway (BRAIN)
#   /media-api/ → Media worker (HANDS)

{$DOMAIN::80} {
	# ── Access gate until the shared Google login is wired ─────────────
	# The front door (/), the live demo (/try), their assets, example photo, icon
	# and robots.txt are public; the workspace and everything behind it asks for the Studio login.
	# The visitor demo webhook is public too; n8n limits it to one run a day.
	@private not path / /try /assets/* /demo/* /favicon.svg /robots.txt /webhook/studio-demo
	basic_auth @private bcrypt "4XOR Studio" {
		{$STUDIO_USER:admin} {$STUDIO_PASS_HASH}
	}

	# ── Dashboard (default) ──────────────────────────────────────────────
	handle {
		# Public pages are read-only (inside the handle: respond runs before reverse_proxy)
		@publicWrite {
			path / /try /assets/* /demo/* /favicon.svg /robots.txt
			not method GET HEAD
		}
		respond @publicWrite 405
		# The dashboard loads only its own bundle; it talks to the map for the signed-in demo.
		# n8n (/n8n/*) is outside this handle and keeps its own looser rules.
		header Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://map.4xor.de; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://map.4xor.de; object-src 'none'"
		reverse_proxy dashboard:3000
	}

	# ── n8n Workflow Editor ──────────────────────────────────────────────
	handle /n8n/* {
		uri strip_prefix /n8n
		reverse_proxy n8n:5678
	}

	# ── Public visitor demo (JSON with one browser-shrunk photo) ────────
	handle /webhook/studio-demo {
		request_body {
			max_size 512KB
		}
		reverse_proxy n8n:5678
	}

	# ── n8n Webhooks (called by dashboard + external triggers) ───────────
	handle /webhook/* {
		reverse_proxy n8n:5678
	}
	handle /webhook-test/* {
		reverse_proxy n8n:5678
	}

	# ── OpenClaw API (internal, but exposed for admin/debug) ─────────────
	handle /api/* {
		reverse_proxy openclaw-gateway:18789
	}

	# ── Media Worker API ─────────────────────────────────────────────────
	handle /media-api/* {
		uri strip_prefix /media-api
		reverse_proxy media-worker:3001
	}

	# ── Static media files (thumbnails, previews) ────────────────────────
	handle /media/* {
		root * /data
		file_server browse
	}

	# ── Security headers ─────────────────────────────────────────────────
	header {
		X-Content-Type-Options nosniff
		X-Frame-Options SAMEORIGIN
		Referrer-Policy strict-origin-when-cross-origin
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# ── Request size limit (500MB for video uploads) ─────────────────────
	request_body {
		max_size 500MB
	}

	# ── Logging ──────────────────────────────────────────────────────────
	log {
		output stdout
		format json
	}
}
